# BIN MALIK FITNESS environment template.
# Values below are the PRODUCTION defaults (cPanel). For local XAMPP development change:
#   APP_ENV=local, APP_DEBUG=true, APP_URL=http://127.0.0.1:8000, DEMO_MODE=true,
#   SESSION_SECURE_COOKIE=false, LOG_LEVEL=debug
# Never commit the real .env file.

APP_NAME="BIN MALIK FITNESS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://binmalikfitness.com
APP_TIMEZONE=Asia/Karachi
APP_CURRENCY=PKR

# Demo role switcher, demo accounts and seeded sample catalogue. Ignored in production.
DEMO_MODE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Error alert e-mails (throttled). Leave empty to disable.
ERROR_ALERT_EMAIL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=binmalikfitness
DB_USERNAME=
DB_PASSWORD=

# Backups (php artisan backup:run, scheduled daily)
MYSQLDUMP_PATH=mysqldump
BACKUP_KEEP_DAYS=14

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Staff accounts (admin, manager, coach) must set up 2FA before using the back office.
REQUIRE_STAFF_2FA=false

# Comma-separated proxy IPs/CIDRs in front of the app (e.g. Cloudflare), or * to trust all.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.binmalikfitness.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@binmalikfitness.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@binmalikfitness.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
